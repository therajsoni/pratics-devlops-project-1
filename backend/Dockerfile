FROM node:20

WORKDIR /app

ARG PORT
ARG CONNECTION_DB
ARG DB_NAME
ARG TOKEN_JENKINS
ARG ENPOINT_JENKINS

ENV PORT=$PORT
ENV CONNECTION_DB=$CONNECTION_DB
ENV DB_NAME=$DB_NAME
ENV ENPOINT_JENKINS=$ENPOINT_JENKINS
ENV TOKEN_JENKINS=$TOKEN_JENKINS


COPY package*.json ./
RUN npm install
COPY . .

EXPOSE 5000
CMD ["npm", "start"]

