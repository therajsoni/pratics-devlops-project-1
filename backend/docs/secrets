4. Args

FROM node:20
WORKDIR /app

# Build-time arguments
ARG PORT
ARG CONNECTION_DB
ARG DB_NAME

# Set as environment variables inside container
ENV PORT=$PORT \
    CONNECTION_DB=$CONNECTION_DB \
    DB_NAME=$DB_NAME

COPY package*.json ./
RUN npm install
COPY . .

EXPOSE $PORT
CMD ["npm", "start"]


docker build \
  --build-arg PORT=5000 \
  --build-arg CONNECTION_DB="mongodb://mongo:27017" \
  --build-arg DB_NAME=todo \
  -t backend-app .
 


